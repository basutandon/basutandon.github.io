import os
import time
from langchain_community.document_loaders import PyPDFLoader
from langchain_text_splitters import RecursiveCharacterTextSplitter
from langchain_community.vectorstores import FAISS
from langchain_ollama import ChatOllama, OllamaEmbeddings
from langchain_classic.chains import create_retrieval_chain
from langchain_classic.chains.combine_documents import create_stuff_documents_chain
from langchain_core.prompts import ChatPromptTemplate

# --- 1. CONFIGURATION ---
# Ensure your NITI Aayog PDF is in the exact same folder as this script
pdf_filename = "CCUS-Report.pdf" 

def main():
    print(f"🚀 Starting Local RAG Pipeline...\n")
    
    # --- 2. LOAD & SPLIT ---
    print(f"1. 🔄 Loading '{pdf_filename}'...")
    if not os.path.exists(pdf_filename):
        print(f"❌ ERROR: File not found. Please place '{pdf_filename}' in {os.getcwd()}")
        return

    loader = PyPDFLoader(pdf_filename)
    docs = loader.load()
    
    # We chop the PDF into chunks of 1000 characters with 200 overlap to maintain context context
    text_splitter = RecursiveCharacterTextSplitter(chunk_size=1000, chunk_overlap=200)
    texts = text_splitter.split_documents(docs)
    print(f"   ✅ Split PDF into {len(texts)} chunks.")

    # --- 3. CREATE VECTOR DATABASE (FAISS) ---
    print("2. 🧠 Generating Vector Embeddings using Llama 3.2..")
    print("   (This runs entirely on your CPU. It may take 1-2 minutes...)")
    start_time = time.time()
    
    embeddings = OllamaEmbeddings(model="nomic-embed-text")
    vectorstore = FAISS.from_documents(documents=texts, embedding=embeddings)
    
    print(f"   ✅ Vector Database built in {round(time.time() - start_time, 2)} seconds.")

    # --- 4. BUILD THE AI CHAIN ---
    print("3. 🔗 Assembling the AI Logic Chain...")
    
    # Initialize the local LLM
    llm = ChatOllama(model="llama3.2", temperature=0)

    # Define the system prompt (Telling the AI how to behave)
    # Define the system prompt (Telling the AI how to behave)
    system_prompt = (
        "You are a strict data extractor. Your ONLY job is to extract information exactly as it appears in the provided context. "
        "CRITICAL RULES:\n"
        "1. Do NOT add any external knowledge, filler sentences, or concluding summaries.\n"
        "2. Do NOT hallucinate or extrapolate beyond what is explicitly written.\n"
        "3. If the context does not clearly contain the answer to the question, you must say EXACTLY: 'The provided document chunks do not contain this information.'\n\n"
        "Context: {context}"
    )
    
    prompt = ChatPromptTemplate.from_messages([
        ("system", system_prompt),
        ("human", "{input}"),
    ])

    # Create the chains
    question_answer_chain = create_stuff_documents_chain(llm, prompt)
    retriever = vectorstore.as_retriever(search_kwargs={"k": 3}) # Fetch top 3 most relevant chunks
    rag_chain = create_retrieval_chain(retriever, question_answer_chain)

    # --- 5. EXECUTE THE QUERY ---
    query = "What are the economic challenges of Carbon Capture?"
    print(f"\n❓ Asking: {query}\n")
    
    print("⏳ AI is thinking...\n")
    response = rag_chain.invoke({"input": query})

    print("--- 🔒 PRIVATE LOCAL ANSWER ---")
    print(response["answer"])
    
    print("\n--- 📄 SOURCES USED ---")
    for i, doc in enumerate(response["context"]):
        print(f"Source {i+1}: Page {doc.metadata.get('page', 'Unknown')}")

    print("\n--- EXACT TEXT THE AI READ ---")
    
    for i, doc in enumerate(response["context"]):
        print(f"\nCHUNK {i+1} (Claimed Page {doc.metadata.get('page', 'Unknown')}):")
        print(doc.page_content)
        print("-" * 50)


if __name__ == "__main__":
    main()

